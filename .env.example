#   SENTRY_AUTH_TOKEN (workflow: preview, production)
#   SENTRY_AUTH_TOKEN (eas-tooling: local, dev, preview, production)
#   secret, optional
sentry-auth-token=

# Worker deploy and delete token.
# Infisical: cloudflare-account-token
#   CLOUDFLARE_API_TOKEN (workflow: preview, production)
#   secret, required
cloudflare-account-token=

# Cloudflare account for Worker deploys.
# Infisical: cloudflare-account-id
#   CLOUDFLARE_ACCOUNT_ID (workflow: preview, production)
#   published, required
cloudflare-account-id=

# Expo access token for Mobile Build and the preview update Deploy publishes.
