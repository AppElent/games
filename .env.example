# Public URL of the Convex deployment each client uses.
# Infisical: convex-url
#   VITE_CONVEX_URL (vite-build: local, dev, preview, production)
#   EXPO_PUBLIC_CONVEX_URL (expo-build: local, dev, preview, production)
#   EXPO_PUBLIC_CONVEX_URL (expo-local: local)
#   published, required
convex-url=

# Selected Convex deployment for local tooling.
# Infisical: convex-deployment
#   CONVEX_DEPLOYMENT (local-tooling: local)
#   published, required
convex-deployment=

# CI deploy key: preview kind in Infisical staging, `prod:` in prod.
# Infisical: convex-deploy-key
#   CONVEX_DEPLOY_KEY (workflow: preview, production)
#   secret, required
convex-deploy-key=

# pk_test_ in Infisical dev, pk_live_ in staging and prod.
# Infisical: clerk-publishable-key
#   VITE_CLERK_PUBLISHABLE_KEY (vite-build: local, dev, preview, production)
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (expo-build: local, dev, preview, production)
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (expo-local: local)
#   published, required
clerk-publishable-key=

# Clerk issuer Convex trusts to validate JWTs.
# Infisical: clerk-jwt-issuer-domain
#   CLERK_JWT_ISSUER_DOMAIN (convex-functions: local, dev, preview, production)
#   published, required
clerk-jwt-issuer-domain=

# +clerk_test address on the development instance.
# Infisical: test-user-email
#   VITE_TEST_USER_EMAIL (vite-build: local, dev)
#   EXPO_PUBLIC_TEST_USER_EMAIL (expo-build: local, dev)
#   EXPO_PUBLIC_TEST_USER_EMAIL (expo-local: local)
#   published, optional
test-user-email=

# Password of the development-instance test user.
# Infisical: test-user-password
#   VITE_TEST_USER_PASSWORD (vite-build: local, dev)
#   EXPO_PUBLIC_TEST_USER_PASSWORD (expo-build: local, dev)
#   EXPO_PUBLIC_TEST_USER_PASSWORD (expo-local: local)
#   published, optional
test-user-password=

# Web origin the mobile app uses for share links.
# Infisical: web-origin
#   EXPO_PUBLIC_WEB_ORIGIN (expo-build: dev, preview, production)
#   published, required
web-origin=

# Public Sentry DSN for the browser, Worker, mobile app and Convex forwarder.
# Infisical: sentry-dsn
#   VITE_SENTRY_DSN (vite-build: local, dev, preview, production)
#   EXPO_PUBLIC_SENTRY_DSN (expo-build: local, dev, preview, production)
#   EXPO_PUBLIC_SENTRY_DSN (expo-local: local)
#   SENTRY_CONVEX_DSN (local-tooling: local)
#   published, optional
sentry-dsn=

# `1` lets a local development bundle of the mobile app report to Sentry.
# Infisical: sentry-debug
#   EXPO_PUBLIC_SENTRY_DEBUG (expo-local: local)
#   published, optional
sentry-debug=

# Source-map and debug-symbol upload token.
# Infisical: sentry-auth-token
