# Public, inlined into the bundle at build time. Never put secrets here.
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# The web origin used for share links (https://…, no trailing slash).
EXPO_PUBLIC_WEB_ORIGIN=
# Optional, pk_test_ instances only: prefill the sign-in form.
EXPO_PUBLIC_TEST_USER_EMAIL=
EXPO_PUBLIC_TEST_USER_PASSWORD=
