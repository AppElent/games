{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		// `app.config.ts` imports `src/lib/app-links.ts` by its full name: Expo
		// transpiles only the config file, and Node strips the types of a `.ts`
		// file it is asked for by extension.
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"types": ["jest", "react"]
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
