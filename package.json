{
  "name": "arcadeclub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --host",
    "dev:all": "pnpm exec convex dev --once && pnpm dev",
    "dev:watch": "concurrently -n convex,vite -c blue,green \"pnpm exec convex dev\" \"pnpm dev\"",
    "generate-routes": "tsr generate",
    "build": "vite build && node scripts/generate-sw.mjs",
    "build:development": "vite build --mode development && node scripts/generate-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && pnpm --filter @arcadeclub/core --filter @arcadeclub/chess --filter @arcadeclub/mobile run typecheck",
    "test": "vitest run && pnpm --filter @arcadeclub/mobile test",
    "test:watch": "vitest",
    "format": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "check": "biome check && node scripts/check-mobile-structure.mjs",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm run deploy:prod",
    "deploy:dev": "pnpm exec convex dev --once && CLOUDFLARE_ENV=dev pnpm run build:development && wrangler deploy",
    "deploy:prod": "node scripts/env.mjs exec production --only github -- pnpm run deploy:production",
    "deploy:production": "convex deploy --cmd-url-env-var-name CONVEX_URL --cmd 'VITE_CONVEX_URL=$CONVEX_URL pnpm build' && wrangler deploy",
    "env:check": "node scripts/env.mjs check",
    "env:plan": "node scripts/env.mjs plan",
    "env:apply": "node scripts/env.mjs apply",
    "env:generate": "node scripts/env.mjs generate",
    "env:exec": "node scripts/env.mjs exec",
    "mobile:update:preview": "node scripts/env.mjs exec preview --only eas -- node apps/mobile/scripts/publish-update.mjs preview",
    "mobile:update:production": "node scripts/env.mjs exec production --only eas -- node apps/mobile/scripts/publish-update.mjs production",
    "sentry:convex": "node scripts/convex-sentry.mjs"
  },
  "dependencies": {
    "@arcadeclub/chess": "workspace:*",
    "@arcadeclub/core": "workspace:*",
    "@clerk/react": "^6.18.4",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@sentry/cloudflare": "11.10.0",
    "@sentry/react": "11.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.4",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@edge-runtime/vm": "^5.0.0",
    "@sentry/node": "11.8.0",
    "@sentry/vite-plugin": "11.8.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/router-cli": "^1.167.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "convex-test": "^0.0.54",
    "jsdom": "^29.1.1",
    "lefthook": "^2.2.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.70.0"
  }
}
