# EAS uploads the repo root (a pnpm workspace). This replaces .gitignore for
# uploads, so it repeats the ignores that matter and adds local-only files.
node_modules
.pnpm-store/
.DS_Store
dist
dist-ssr
.output
.nitro
.tanstack
.wrangler
.convex/
*.local
.env*
!.env.example
.dev.vars*
!.dev.vars.example
.claude/
.appelent/
coverage/

# Expo generates native projects on EAS; exclude local caches and signing files.
.expo/
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/
apps/mobile/dist/
*.tsbuildinfo
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
