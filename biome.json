{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"!**/src/routeTree.gen.ts",
			"apps/mobile/app/**/*",
			"apps/mobile/*.ts",
			"apps/mobile/*.js",
			"!**/src/styles.css",
			"!**/.claude",
			"!**/.expo",
			"!apps/mobile/expo-env.d.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["apps/mobile/**", "!apps/mobile/src/convex/query-cache.tsx"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"convex/react": {
										"importNames": [
											"useQuery",
											"useQueries",
											"usePaginatedQuery"
										],
										"message": "Import query hooks from src/convex/query-cache (retention cache, see docs/standards/convex-query-caching.md)."
									}
								}
							}
						}
					}
				}
			}
		}
	]
}
