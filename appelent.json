{
  "schemaVersion": 1,
  "envManifest": "env.manifest.ts",
  "features": {
    "baseline": { "version": 5, "steps": [6, 14, 15] },
    "auth": { "version": 1 },
    "i18n": { "version": 1 }
  },
  "workspace": {
    "backend": {
      "mode": "cloud",
      "project": "eric-jansen:games",
      "expiration": "in 5 days",
      "scopedCredential": false,
      "push": true
    },
    "install": true,
    "buildScripts": [],
    "outputs": {
      "rootEnv": ".env.local",
      "mobileEnv": "apps/mobile/.env.local",
      "mobileUrlName": "EXPO_PUBLIC_CONVEX_URL"
    },
    "ports": {
      "web": 3000,
      "mobile": 8081
    }
  }
}
