{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "All (dev:watch)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev:watch"
      ],
      "port": 3000
    },
    {
      "name": "Vite only",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vite",
        "dev",
        "--port",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "Vite alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vite",
        "dev",
        "--port",
        "3002"
      ],
      "port": 3002
    }
  ]
}
